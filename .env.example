
BOT_TELEGRAM_BOT_TOKEN=
# необязательная, по умолчанию INFO:
# BOT_LOG_LEVEL=INFO
BOT_DATABASE_URL=postgresql+asyncpg://spiritvpn_bot:spiritvpn_bot@localhost:5434/spiritvpn_bot

BOT_SPIRITVPND_GRPC_TARGET=localhost:8443
BOT_SPIRITVPND_TLS_CLIENT_CERT_FILE=./certs/dev/product-svc.crt
BOT_SPIRITVPND_TLS_CLIENT_KEY_FILE=./certs/dev/product-svc.key
BOT_SPIRITVPND_TLS_CA_FILE=./certs/dev/ca.crt

BOT_SUBSCRIPTION_BASE_URL=http://localhost:8080
BOT_MINI_APP_URL=http://localhost:8080
# необязательно, порт `python -m spiritvpn_bot api`, по умолчанию 8080 —
# смените, если совпадает с портом локального spiritvpnd (SPIRIT_HTTP_LISTEN)
# BOT_MINI_APP_HTTP_PORT=8080

# Кнопки приветственного сообщения /start и команда /support.
BOT_SUPPORT_URL=https://t.me/spiritvpn_support
BOT_REVIEWS_URL=https://t.me/spiritvpn_reviews

# Секрет подписи токена /s/{token} (SubscriptionTokenSigner). Для dev —
# любая случайная строка, например `python3 -c "import secrets; print(secrets.token_hex(32))"`.
BOT_SUBSCRIPTION_SIGNING_KEY=

# vpn_fleet_id из текущего манифеста spiritvpnd для бесплатного плана.
BOT_FRIENDS_PLAN_FLEET_ID=
# необязательные, есть значения по умолчанию:
# BOT_FRIENDS_PLAN_QUOTA_BYTES=107374182400
# BOT_FRIENDS_PLAN_DURATION_DAYS=30

# Общий пароль для бесплатного доступа — только для своих. Один на всех, не
# персональный, задаётся здесь и нигде больше.
BOT_FRIENDS_SHARED_CODE=

# Пересылка логов уровня error/exception в топик Telegram — тот же общий
# топик ошибок, что и у SpiritVPN/Infrastructure, поэтому и переменные без
# префикса BOT_ — те же самые имена, что у остальных сервисов. Не задан
# TELEGRAM_CHAT_ID — уведомления выключены целиком.
# TELEGRAM_CHAT_ID=
# TELEGRAM_BOT_TOKEN=
# необязательно, message_thread_id топика внутри группы, если это форум:
# BOT_ERROR_NOTIFICATIONS_MESSAGE_THREAD_ID=
